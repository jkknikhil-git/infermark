{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunResult",
  "type": "object",
  "required": [
    "finished_at",
    "hardware",
    "infermark_version",
    "modules",
    "plan",
    "profile",
    "run_id",
    "schema",
    "started_at"
  ],
  "properties": {
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "hardware": {
      "$ref": "#/definitions/HardwareInfo"
    },
    "infermark_version": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModuleRecord"
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PlanEntry"
      }
    },
    "profile": {
      "description": "The exact profile used, so the run can be reproduced.",
      "allOf": [
        {
          "$ref": "#/definitions/Profile"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "telemetry": {
      "description": "Sensor data sampled for the whole run. Absent in results from before telemetry existed.",
      "anyOf": [
        {
          "$ref": "#/definitions/Telemetry"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "BatteryInfo": {
      "type": "object",
      "required": [
        "charge_percent",
        "charging"
      ],
      "properties": {
        "charge_percent": {
          "description": "0.0 - 100.0",
          "type": "number",
          "format": "double"
        },
        "charging": {
          "type": "boolean"
        },
        "design_capacity_wh": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "full_capacity_wh": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "CpuInfo": {
      "type": "object",
      "required": [
        "brand",
        "logical_cores",
        "vendor"
      ],
      "properties": {
        "brand": {
          "type": "string"
        },
        "frequency_mhz": {
          "description": "Reported base/current frequency in MHz.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "logical_cores": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "physical_cores": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "vendor": {
          "type": "string"
        }
      }
    },
    "Direction": {
      "type": "string",
      "enum": [
        "higher-is-better",
        "lower-is-better",
        "neutral"
      ]
    },
    "GateSettings": {
      "description": "Thresholds that decide which models are too big or too slow for this device.",
      "type": "object",
      "properties": {
        "allow_ineligible": {
          "description": "Run models even when the gate says they won't fit (\"I know what I'm doing\").",
          "default": false,
          "type": "boolean"
        },
        "memory_margin": {
          "description": "Fraction of available memory a model may use.",
          "default": 0.85,
          "type": "number",
          "format": "double"
        },
        "min_tokens_per_sec": {
          "description": "Skip models predicted to generate slower than this.",
          "default": 2.0,
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "GpuInfo": {
      "type": "object",
      "required": [
        "integrated",
        "name",
        "vendor"
      ],
      "properties": {
        "dedicated_vram_bytes": {
          "description": "Dedicated video memory. `None` if unknown; integrated GPUs typically report a small value or 0.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "driver_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "integrated": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "shared_memory_bytes": {
          "description": "System memory the GPU can borrow (integrated GPUs, unified memory).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "vendor": {
          "$ref": "#/definitions/GpuVendor"
        }
      }
    },
    "GpuVendor": {
      "type": "string",
      "enum": [
        "nvidia",
        "amd",
        "intel",
        "apple",
        "qualcomm",
        "arm",
        "microsoft",
        "other"
      ]
    },
    "HardwareInfo": {
      "type": "object",
      "required": [
        "cpu",
        "fingerprint",
        "memory",
        "os",
        "power_source"
      ],
      "properties": {
        "battery": {
          "description": "`None` when the device has no battery (desktops).",
          "anyOf": [
            {
              "$ref": "#/definitions/BatteryInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu": {
          "$ref": "#/definitions/CpuInfo"
        },
        "fingerprint": {
          "description": "Stable, anonymous hash of the hardware configuration (same machine -> same fingerprint).",
          "type": "string"
        },
        "gpus": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/GpuInfo"
          }
        },
        "memory": {
          "$ref": "#/definitions/MemoryInfo"
        },
        "npus": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/NpuInfo"
          }
        },
        "os": {
          "$ref": "#/definitions/OsInfo"
        },
        "power_source": {
          "$ref": "#/definitions/PowerSource"
        }
      }
    },
    "MemoryInfo": {
      "type": "object",
      "required": [
        "available_bytes",
        "total_bytes"
      ],
      "properties": {
        "available_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "Metric": {
      "description": "A single headline number.",
      "type": "object",
      "required": [
        "direction",
        "key",
        "label",
        "unit",
        "value"
      ],
      "properties": {
        "direction": {
          "$ref": "#/definitions/Direction"
        },
        "key": {
          "description": "Stable key, e.g. `triad_gbps`.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "ModelSelection": {
      "type": "object",
      "properties": {
        "catalog": {
          "description": "Catalog model ids; empty = let the gate pick from the whole catalog.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "local_paths": {
          "description": "Extra local `.gguf` files to benchmark.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_params_b": {
          "description": "Ignore catalog models larger than this many billion parameters.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "ollama": {
          "description": "Models already installed in Ollama, e.g. `llama3.1:8b`.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ModuleCategory": {
      "type": "string",
      "enum": [
        "system",
        "microbenchmark",
        "inference",
        "endurance",
        "battery",
        "quality"
      ]
    },
    "ModuleDescriptor": {
      "type": "object",
      "required": [
        "category",
        "description",
        "estimated_seconds",
        "id",
        "name"
      ],
      "properties": {
        "category": {
          "$ref": "#/definitions/ModuleCategory"
        },
        "description": {
          "type": "string"
        },
        "estimated_seconds": {
          "description": "Rough duration estimate with default settings, shown in the run wizard.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "description": "Stable kebab-case id used in profiles, e.g. `memory-bandwidth`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "requirements": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Requirement"
          }
        }
      }
    },
    "ModuleOutput": {
      "type": "object",
      "properties": {
        "metrics": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Metric"
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Series"
          }
        }
      }
    },
    "ModuleRecord": {
      "type": "object",
      "required": [
        "duration_ms",
        "module_id",
        "status"
      ],
      "properties": {
        "duration_ms": {
          "type": "number",
          "format": "double"
        },
        "module_id": {
          "type": "string"
        },
        "offset_ms": {
          "description": "When the module started, in ms since the run started (lines it up with telemetry).",
          "default": 0.0,
          "type": "number",
          "format": "double"
        },
        "output": {
          "default": {
            "metrics": [],
            "notes": [],
            "series": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/ModuleOutput"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/ModuleStatus"
        }
      }
    },
    "ModuleSelection": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "ModuleStatus": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "status"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "skipped"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "error",
            "status"
          ],
          "properties": {
            "error": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "failed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "cancelled"
              ]
            }
          }
        }
      ]
    },
    "NpuInfo": {
      "type": "object",
      "required": [
        "name",
        "vendor"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        }
      }
    },
    "OsFamily": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux",
        "android",
        "ios",
        "other"
      ]
    },
    "OsInfo": {
      "type": "object",
      "required": [
        "arch",
        "family",
        "kernel",
        "name",
        "version"
      ],
      "properties": {
        "arch": {
          "type": "string"
        },
        "family": {
          "$ref": "#/definitions/OsFamily"
        },
        "kernel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "PackSelection": {
      "type": "object",
      "properties": {
        "exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include": {
          "description": "Pack ids to run; `[\"*\"]` = every installed pack.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_items_per_pack": {
          "description": "Use at most this many items per pack (handy for quick runs).",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "PlanEntry": {
      "description": "What the planner decided for one module, before anything ran.",
      "type": "object",
      "required": [
        "module_id",
        "status"
      ],
      "properties": {
        "descriptor": {
          "description": "`None` when the profile names a module this build doesn't have.",
          "anyOf": [
            {
              "$ref": "#/definitions/ModuleDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/PlanStatus"
        }
      }
    },
    "PlanStatus": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "planned"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "status"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "skipped"
              ]
            }
          }
        }
      ]
    },
    "PowerSource": {
      "type": "string",
      "enum": [
        "ac",
        "battery",
        "unknown"
      ]
    },
    "Profile": {
      "type": "object",
      "required": [
        "name",
        "schema"
      ],
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "gate": {
          "default": {
            "allow_ineligible": false,
            "memory_margin": 0.85,
            "min_tokens_per_sec": 2.0
          },
          "allOf": [
            {
              "$ref": "#/definitions/GateSettings"
            }
          ]
        },
        "models": {
          "default": {
            "catalog": [],
            "local_paths": [],
            "max_params_b": null,
            "ollama": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/ModelSelection"
            }
          ]
        },
        "modules": {
          "description": "Modules to run, in order. Keys are module ids; values hold `enabled` plus module settings.",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ModuleSelection"
          }
        },
        "name": {
          "type": "string"
        },
        "packs": {
          "default": {
            "exclude": [],
            "include": [],
            "max_items_per_pack": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/PackSelection"
            }
          ]
        },
        "run": {
          "default": {
            "backend": "auto",
            "context_sizes": [
              512,
              2048
            ],
            "gpu_layers": null,
            "repeats": 3,
            "seed": 42,
            "think": false,
            "threads": null,
            "warmups": 1
          },
          "allOf": [
            {
              "$ref": "#/definitions/RunSettings"
            }
          ]
        },
        "schema": {
          "description": "File format version; must be 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "scoring": {
          "default": {
            "efficiency": 0.1,
            "endurance": 0.15,
            "quality": 0.3,
            "responsiveness": 0.2,
            "speed": 0.25
          },
          "allOf": [
            {
              "$ref": "#/definitions/ScoringWeights"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Requirement": {
      "description": "Something a module needs from the hardware or environment.",
      "oneOf": [
        {
          "description": "At least this much total system RAM.",
          "type": "object",
          "required": [
            "gb",
            "kind"
          ],
          "properties": {
            "gb": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "min-ram-gb"
              ]
            }
          }
        },
        {
          "description": "At least this much dedicated VRAM on some GPU.",
          "type": "object",
          "required": [
            "gb",
            "kind"
          ],
          "properties": {
            "gb": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "min-vram-gb"
              ]
            }
          }
        },
        {
          "description": "Any GPU at all (integrated counts).",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "any-gpu"
              ]
            }
          }
        },
        {
          "description": "A GPU from a specific vendor (e.g. NVML-based telemetry needs NVIDIA).",
          "type": "object",
          "required": [
            "kind",
            "vendor"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "gpu-vendor"
              ]
            },
            "vendor": {
              "$ref": "#/definitions/GpuVendor"
            }
          }
        },
        {
          "description": "A battery must be present.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "battery"
              ]
            }
          }
        },
        {
          "description": "Must be running on battery power (battery drain tests).",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "on-battery-power"
              ]
            }
          }
        },
        {
          "description": "Only on these operating systems.",
          "type": "object",
          "required": [
            "families",
            "kind"
          ],
          "properties": {
            "families": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/OsFamily"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "os"
              ]
            }
          }
        }
      ]
    },
    "RunSettings": {
      "type": "object",
      "properties": {
        "backend": {
          "description": "`auto`, `llama-cpp`, `ollama`, …",
          "default": "auto",
          "type": "string"
        },
        "context_sizes": {
          "description": "Prompt lengths (tokens) used by context-scaling tests.",
          "default": [
            512,
            2048
          ],
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "gpu_layers": {
          "description": "Layers to offload to the GPU; `None` = automatic, 0 = CPU only.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "repeats": {
          "description": "Measured repetitions per test (results report the median).",
          "default": 3,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "seed": {
          "default": 42,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "think": {
          "description": "Allow reasoning (\"thinking\") output for models that support it.",
          "default": false,
          "type": "boolean"
        },
        "threads": {
          "description": "CPU threads for inference; `None` = let the backend decide.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "warmups": {
          "description": "Unmeasured warm-up runs before measuring.",
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ScoringWeights": {
      "description": "Relative weights of the sub-scores in the overall InferMark Score.",
      "type": "object",
      "properties": {
        "efficiency": {
          "default": 0.1,
          "type": "number",
          "format": "double"
        },
        "endurance": {
          "default": 0.15,
          "type": "number",
          "format": "double"
        },
        "quality": {
          "default": 0.3,
          "type": "number",
          "format": "double"
        },
        "responsiveness": {
          "default": 0.2,
          "type": "number",
          "format": "double"
        },
        "speed": {
          "default": 0.25,
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "SensorChannel": {
      "description": "Something a provider can measure, e.g. `gpu0` + [`SensorKind::Power`].",
      "type": "object",
      "required": [
        "kind",
        "label",
        "source"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/SensorKind"
        },
        "label": {
          "description": "Human-readable, e.g. \"GPU power\".",
          "type": "string"
        },
        "source": {
          "description": "What is measured: `cpu`, `gpu0`, `battery`, `system`, `device`.",
          "type": "string"
        }
      }
    },
    "SensorInventory": {
      "description": "Which sensors existed during a run (recorded in results).",
      "type": "object",
      "required": [
        "available",
        "missing"
      ],
      "properties": {
        "available": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SensorChannel"
          }
        },
        "missing": {
          "description": "Standard measurements this device doesn't offer, so the app can say so.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SensorChannel"
          }
        }
      }
    },
    "SensorKind": {
      "oneOf": [
        {
          "description": "°C",
          "type": "string",
          "enum": [
            "temperature"
          ]
        },
        {
          "description": "MHz",
          "type": "string",
          "enum": [
            "clock"
          ]
        },
        {
          "description": "Percent 0-100",
          "type": "string",
          "enum": [
            "utilization"
          ]
        },
        {
          "description": "Watts (drawn by the component; for a battery, the discharge rate)",
          "type": "string",
          "enum": [
            "power"
          ]
        },
        {
          "description": "Bytes",
          "type": "string",
          "enum": [
            "memory-used"
          ]
        },
        {
          "description": "Percent 0-100",
          "type": "string",
          "enum": [
            "battery-charge"
          ]
        },
        {
          "description": "[`ThermalState`] as 0-3. Phones and macOS report this instead of temperatures.",
          "type": "string",
          "enum": [
            "thermal-state"
          ]
        }
      ]
    },
    "Series": {
      "description": "A time series (or any x/y series) for graphs.",
      "type": "object",
      "required": [
        "key",
        "label",
        "points",
        "x_unit",
        "y_unit"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "number",
                "format": "double"
              },
              {
                "type": "number",
                "format": "double"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "x_unit": {
          "type": "string"
        },
        "y_unit": {
          "type": "string"
        }
      }
    },
    "Telemetry": {
      "description": "Background sensor readings recorded while the run was going.",
      "type": "object",
      "required": [
        "interval_ms",
        "sensors"
      ],
      "properties": {
        "interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sensors": {
          "description": "Which sensors this device offered, and which standard ones it didn't.",
          "allOf": [
            {
              "$ref": "#/definitions/SensorInventory"
            }
          ]
        },
        "series": {
          "description": "One series per sensor that produced values, keyed `source.kind` (e.g. `cpu.utilization`); x is seconds since the run started.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Series"
          }
        }
      }
    }
  }
